# Postgres 15+ with the pgvector extension (Neon free tier works)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# At least 32 random characters. Optional with a hosted database: derived from DATABASE_URL when unset.
JWT_SECRET=change-me-to-a-long-random-string
# Free key from https://aistudio.google.com/apikey (without it the app runs an offline extractive fallback)
GEMINI_API_KEY=
# Optional overrides
CHAT_MODEL=gemini-flash-latest
FAST_MODEL=gemini-flash-lite-latest
EMBED_MODEL=gemini-embedding-001
RERANKER=llm
TOP_K=6
MIN_RELEVANCE=0.35
CORS_ORIGINS=http://localhost:5173
